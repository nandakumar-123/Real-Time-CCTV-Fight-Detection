# ==============================================================================
# CCTV AI Fight Detection - Environment Configuration
# Enter the absolute paths to your local dataset folders below.
# Example: RWF2000_DATA_DIR=C:/Datasets/RWF-2000
# ==============================================================================

RWF2000_DATA_DIR=
NTU_CCTV_FIGHTS_DATA_DIR=
MODEL_ID=OpenGVLab/VideoMAEv2-Base
DEVICE=auto

# Project Paths
PROJECT_ROOT=./
OUTPUT_DIR=./outputs
CHECKPOINT_DIR=./checkpoints
LOG_DIR=./logs
REPORT_DIR=./reports
UPLOAD_DIR=./uploads

# Model & Video Parameters
NUM_FRAMES=16
IMAGE_SIZE=224

# Training Parameters
EPOCHS=30
TARGET_ACCURACY=0.85
RANDOM_SEED=42

# Hardware & Execution (Set to 'auto' for dynamic detection)
BATCH_SIZE=auto
NUM_WORKERS=auto
LEARNING_RATE=auto

# Resource Safety Limits
MAX_RAM_PERCENT=85.0
MAX_VRAM_PERCENT=90.0
MAX_CPU_THREADS=8
